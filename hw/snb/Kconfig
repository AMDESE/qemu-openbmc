config SNB
    bool
    default y if ASPEED_SOC

config SNB_I2C_BRIDGE
    bool
    default y if ASPEED_SOC
    depends on I2C
    select SNB

config SNB_I3C_BRIDGE
    bool
    default y if ASPEED_SOC
    depends on I3C
    select SNB

config SNB_GPIO_BRIDGE
    bool
    default y if ASPEED_SOC
    depends on ASPEED_SOC
    select SNB
